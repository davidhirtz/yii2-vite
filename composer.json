{
  "name": "davidhirtz/yii2-vite",
  "description": "Vite integration for Yii 2 framework",
  "license": "proprietary",
  "type": "yii2-extension",
  "homepage": "https://www.github.com/davidhirtz/yii2-vite",
  "authors": [
    {
      "name": "David Hirtz",
      "homepage": "https://www.davidhirtz.com/"
    }
  ],
  "require": {
    "php": "^8.3",
    "davidhirtz/yii2-skeleton": "^3.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Hirtz\\Vite\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hirtz\\Vite\\Tests\\": "tests"
    }
  },
  "extra": {
    "bootstrap": "Hirtz\\Vite\\Bootstrap",
    "branch-alias": {
      "dev-main": "3.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "phpstan": "phpstan --memory-limit=2G",
    "test": "phpunit"
  }
}
